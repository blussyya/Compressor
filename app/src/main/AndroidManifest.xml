<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Only needed on API 23-28 to save the compressed video into the public
        Movies collection; API 29+ (scoped storage) writes to MediaStore without it.
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Foreground service so an export survives the app being backgrounded. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <!-- Without this (API 33+) the foreground service still runs, it just posts no visible notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Squish"
        android:supportsRtl="true"
        android:theme="@style/Theme.Squish">

        <!--
            Two ways in: tap the launcher icon (MAIN/LAUNCHER, shows the picker-driven
            home screen) or share a video to it from another app (SEND). Both funnel
            into the same decision/progress/result flow.

            No android:configChanges here: a ViewModel now survives rotation and
            keeps the Transformer running, so there's nothing left to hack around.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Squish">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <service
            android:name=".CompressionForegroundService"
            android:exported="false"
            android:foregroundServiceType="mediaProcessing" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
